
# --- Images & Tags ---
FRONTEND_IMAGE=brewlite-frontend
BACKEND_IMAGE=brewlite-backend
IMAGE_TAG=latest

# --- Service Ports ---
FRONTEND_PORT=3000
BACKEND_PORT=4000
DB_EXPOSED_PORT=5433


POSTGRES_USER=brewlite
POSTGRES_PASSWORD=brewlite
POSTGRES_DB=brewlite
DATABASE_URL=postgresql://brewlite:brewlite@db:5432/brewlite?schema=public

# --- Backend Service Config ---
PORT=4000
CORS_ORIGIN=http://localhost:3000


JWT_SECRET=dev-super-secret-jwt-key
JWT_ACCESS_SECRET=dev-super-secret-access-key
JWT_REFRESH_SECRET=dev-super-secret-refresh-key

# --- Frontend Service Config ---
# URL gọi từ Trình duyệt Client -> Backend
NEXT_PUBLIC_API_URL=http://localhost:4000

# URL gọi từ Next.js Server-Side (SSR) -> Backend qua mạng nội bộ Docker
INTERNAL_API_URL=http://backend:4000